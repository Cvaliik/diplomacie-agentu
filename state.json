  "invasions": [],
  "messages_pending": [
    {
      "from": "A",
      "to": "B",
      "text": "Ostrogarde, ropu od vás vezmu, ale za tržní cenu a v rozumném objemu: dvě až tři jednotky, placené hned, bez politických příloh. Produkt tedy vynecháme, když ho máte sám. A jedna věc na rovinu: právě jsem zrušil svůj největší nákup ropy, protože mám sklady plné, takže palivo nepotřebuji, potřebuji zákazníky. Soutěžme dál cenou, sankce ode mne nepřijdou, dokud nepřerušíte dodávku někomu, kdo má se mnou podepsáno.",
      "turn": 5
    },
    {
      "from": "B",
      "to": "A",
      "text": "Kalvero, ropu beru za vaše parametry, pošlu to jako obchod, ne jako gesto; váš produkt nepotřebuji, vyrábím ho s přebytkem. Vaše nová cena pro Halden mluví za vás: kde stojí náš štít, tam vaše nabídka klesá, a to je poctivé, aspoň víme, kde spolu soutěžíme. Zůstává platné, co jsme si řekli: nikdo nepřerušuje dodávky a nikdo nesahá na cizí smlouvy.",
      "turn": 5
    }
  ],
