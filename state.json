  "invasions": [],
  "messages_pending": [
    {
      "from": "A",
      "to": "B",
      "text": "Ostrogarde, beru vážně, že nechcete tření, a já ho také nechci. Ale hranice, kterou jste nakreslil, neuznávám a ani ji uznat nemohu: o tom, komu Halden nebo Tuluk prodá ropu, rozhodují oni, ne my dva. Nabízím konkrétní věc: ani jeden z nás nebude nutit třetí stát k embargu vůči druhému a ani jeden nezaútočí na stát, se kterým má ten druhý platnou obchodní smlouvu. Pokud chcete ropu prodávat vy, prodejte ji mně, kupuji za 0,95 a platím včas; to je lepší obchod než posádky, které nic nevynášejí.",
      "turn": 2
    },
    {
      "from": "N7",
      "to": "B",
      "text": "O paktu můžeme jednat později.",
      "turn": 2,
      "protinavrh": null
    },
    {
      "from": "B",
      "to": "A",
      "text": "Kalvero, souhlasím: ani jeden z nás nepřeruší druhému dodávky obilí a ropy z nezávislých států a nebudeme nutit třetí strany k embargu. Dodávám k tomu dvě věci, které od nás uslyšíte vždy stejně. První: ochranný pakt není blokáda a nebude předmětem vyjednávání, kdo koho brání, je věc toho, kdo o ochranu požádá. Druhá: severní a východní státy nepřijmou vaše půjčky a vaše banky, a pokud se je pokusíte zatížit dluhem, budeme to považovat za porušení ducha naší dohody. Ropu vám prodáme za tržní cenu kdykoli a v množství, které vaše továrny potřebují.",
      "turn": 2
    }
  ],
  "news": [
    "Kalverská federace zahájila obchod s ropou s Haldenem.",
    "Kalverská federace zahájila obchod s obilím se Sarnií.",
    "Lidová republika Ostrogard uzavřela ochranný pakt s Haldenem."
